[Unit]
Description=Reeldemo lead-magnet claim/download service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=s4il0r
Group=s4il0r
EnvironmentFile=/etc/reeldemo-leadmagnet/env
WorkingDirectory=/opt/reeldemo-leadmagnet
ExecStart=/usr/bin/python3 /opt/reeldemo-leadmagnet/server.py
Restart=always
RestartSec=3
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
